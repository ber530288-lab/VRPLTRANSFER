DISCORD_TOKEN=put-your-bot-token-here
# Optional: your server ID makes slash commands appear instantly
GUILD_ID=
# Public URL of your league logo (upload the logo to Discord/Imgur and paste the link)
LEAGUE_LOGO_URL=
# "View Profile" button link. {user_id} is replaced with the player's Discord ID.
# Swap this for your league website profile page later.
PROFILE_URL=https://discord.com/users/{user_id}
LEAGUE_NAME=VCL X NAPXR.GG | PitchX
# Short name used on embed headers/footers (e.g. "PitchX Transactions")
LEAGUE_SHORT=NAPXR
# Link for the "Open Your Dashboard" button on reminders (leave empty to hide the button)
DASHBOARD_URL=
# Days between league reminders
REMINDER_DAYS=14
# Hours before kickoff that the matchday brief is sent automatically
MATCHDAY_LEAD_HOURS=24
# Default timezone for entering fixture times (can also be changed with /timezone)
LEAGUE_TZ=UTC
# --- Economy (all optional) ---
# Starting budget for every team
START_BUDGET=100000000
# A transfer fee must be at least this % of the player's market value (0 = no minimum)
MIN_FEE_PERCENT=100
# Player market value = base + goals/assists/clean sheets, with diminishing returns and a hard cap
PLAYER_BASE_VALUE=500000
GOAL_VALUE=600000
ASSIST_VALUE=350000
CLEANSHEET_VALUE=400000
VALUE_SOFT_CAP=6000000
MAX_PLAYER_VALUE=20000000
# --- Data safety (all optional) ---
# Keep your data in ONE fixed place so updates/new folders never start a fresh database, e.g. /home/container/data/pitchx.db
DB_PATH=
# Where automatic backups go (defaults to a "backups" folder next to the database)
BACKUP_DIR=
# How many backups to keep
BACKUP_KEEP=30
# 1 = if the database is ever empty but a backup exists, restore it automatically. 0 = never.
AUTO_RESTORE=1
# Value added to a free agent when they sign for a team
SIGN_VALUE_BONUS=500000
# Off-host backups: the bot keeps a private Discord channel called "pitchx-backups" with a copy of your data.
# 1 = create that channel automatically if it's missing (needs the Manage Channels permission), 0 = never create it
AUTO_BACKUP_CHANNEL=1
# Optional: the ID of an existing private channel to use instead
BACKUP_CHANNEL_ID=
